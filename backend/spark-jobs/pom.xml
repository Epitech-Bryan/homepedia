<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.homepedia</groupId>
        <artifactId>homepedia-backend</artifactId>
        <version>3.75.0</version>
    </parent>

    <artifactId>spark-jobs</artifactId>
    <name>homepedia-spark-jobs</name>
    <description>Spark batch jobs for heavy DVF aggregations</description>

    <properties>
        <!-- Compile to Java 17 bytecode: the official apache/spark 3.5.x
             runtime image ships a Java 17 JRE, so a release-21 jar fails class
             loading (UnsupportedClassVersionError 65.0 vs 61.0). All language
             features used here exist in 17. -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <spark.version>3.5.8</spark.version>
        <!-- Scala 2.12 to match the official apache/spark runtime image
             (apache/spark only publishes 2.12 variants for 3.5.x). The jar is
             submitted in local[*] mode against that image, so the build Scala
             version must equal the runtime's or class loading fails. -->
        <scala.version>2.12</scala.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-core_${scala.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- MLlib (LSH approximate-nearest-neighbour for comparables, hedonic
             regression). Provided: the Spark distribution ships these jars on
             the cluster classpath, so they stay out of the shaded job jar. -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-mllib_${scala.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>spark</shadedClassifierName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
